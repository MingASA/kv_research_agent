{"GPU_device_nodes": [], "uid": 1005, "ldd": {"returncode": 0, "stdout": "\tlinux-vdso.so.1 (0x00007ffcbbdfd000)\n\tlibpython3.12.so.1.0 => /usr/lib/x86_64-linux-gnu/libpython3.12.so.1.0 (0x00007f700b988000)\n\tlibxxhash.so.0 => /usr/lib/x86_64-linux-gnu/libxxhash.so.0 (0x00007f700b975000)\n\tlibzstd.so.1 => /usr/lib/x86_64-linux-gnu/libzstd.so.1 (0x00007f700b8bb000)\n\tlibasio.so => /workspace/agent_work/builds/nextgen-native-kv-59fc32ac-20261027d/build/mooncake-common/libasio.so (0x00007f700b86e000)\n\tlibibverbs.so.1 => /usr/lib/x86_64-linux-gnu/libibverbs.so.1 (0x00007f700b84b000)\n\tlibmlx5.so.1 => /usr/lib/x86_64-linux-gnu/libmlx5.so.1 (0x00007f700b7c3000)\n\tlibm.so.6 => /usr/lib/x86_64-linux-gnu/libm.so.6 (0x00007f700b6da000)\n\tlibtorch_python.so => /usr/local/lib/python3.12/dist-packages/torch/lib/libtorch_python.so (0x00007f700a095000)\n\tlibcuda.so.1 => /usr/lib/x86_64-linux-gnu/libcuda.so.1 (0x00007f700444a000)\n\tlibcudart.so.13 => /usr/local/cuda/lib64/libcudart.so.13 (0x00007f7004000000)\n\tlibnuma.so.1 => /usr/lib/x86_64-linux-gnu/libnuma.so.1 (0x00007f700443c000)\n\tlibtvm_ffi.so => /workspace/.venv/lib/python3.12/site-packages/tvm_ffi/lib/libtvm_ffi.so (0x00007f7003e15000)\n\tlibtorch.so => /usr/local/lib/python3.12/dist-packages/torch/lib/libtorch.so (0x00007f70043f7000)\n\tlibtorch_cpu.so => /usr/local/lib/python3.12/dist-packages/torch/lib/libtorch_cpu.so (0x00007f6fee9ab000)\n\tlibtorch_cuda.so => /usr/local/lib/python3.12/dist-packages/torch/lib/libtorch_cuda.so (0x00007f6fd047a000)\n\tlibc10_cuda.so => /usr/local/lib/python3.12/dist-packages/torch/lib/libc10_cuda.so (0x00007f7004361000)\n\tlibc10.so => /usr/local/lib/python3.12/dist-packages/torch/lib/libc10.so (0x00007f6fd0350000)\n\tlibstdc++.so.6 => /usr/lib/x86_64-linux-gnu/libstdc++.so.6 (0x00007f6fd00d2000)\n\tlibgcc_s.so.1 => /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 (0x00007f7004333000)\n\tlibc.so.6 => /usr/lib/x86_64-linux-gnu/libc.so.6 (0x00007f6fcfec0000)\n\t/lib64/ld-linux-x86-64.s