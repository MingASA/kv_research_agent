.","436:    NOTE(Zihao): this function is a workaround for the lack of support for certain features in","437:    our FA3 backend, and will be removed once the backend is fully supported.","438:","439:    Parameters","440:    ----------","441:    pos_encoding_mode : int","442:        The positional encoding mode.","443:    use_fp16_qk_reductions : bool","444:        Whether FP16 QK reductions are allowed.","445:    use_custom_mask : bool","446:        Whether a custom mask is used.","447:    dtype_q : torch.dtype","448:        The data type of the query tensor.","449:    dtype_kv : torch.dtype","450:        The data type of the key-value tensor.","451:","452:    Returns","453:    -------","454:    bool","455:        True if the FA3 backend is supported, False otherwise.","456:    \"\"\"","457:    if use_custom_mask:","458:        return False","459:    if pos_encoding_mode != PosEncodingMode.NONE.value:","460:        return False","461:    if use_fp16_qk_reductions:","462:        return False","463:    # FA3 FP8 KV cache currently requires FP8 query.","464:    if dtype_kv in {torch.float8_e4m3fn, torch.float8_e5m2} and dtype_q not in {","465:        torch.float8_e4m3fn,","466:        torch.float8_e5m2,","467:    }:","468:        return False","469:    # FA3 does not support NVFP4 KV cache (uint8 packed FP4).","470:    if dtype_kv == torch.uint8:","471:        return False","472:    return True","473:","474:","475:def is_fa3_prefill_head_dim_supported(head_dim_qk: int, head_dim_vo: int) -> bool:","476:    \"\"\"Return whether FA3 prefill supports the QK/VO head-dim pair.\"\"\"","477:    if head_dim_qk == head_dim_vo:","478:        return head_dim_qk in {64, 128, 256}","479:    return (head_dim_qk, head_dim_vo) == (192, 128)"]}
